---
/*
 * 全站页面外壳：doctype、<head>、页头、页脚。
 *
 * 只负责所有页面都一样的部分；<main> 留给各页面自己写，
 * 因为首页和文章页的 main 有不同的布局类名与宽度。
 *
 * 约定：
 *   - 全站语言统一为 zh-CN，页面不要再自己写 <html>。
 *   - 导航高亮由 HeaderLink 按 pathname 自动判断，这里不再传特例。
 *   - 页面独有的 <head> 内容（如 404 的 noindex）放进 head 具名插槽。
 */
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageBackdrop from '../components/PageBackdrop.astro';
import { getBackdrop, type BackdropKey } from '../lib/backdrops';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description: string;
	/** 用于 og:image / twitter:image；不传时由 BaseHead 用占位图兜底 */
	image?: ImageMetadata;
	/** Open Graph 类型；文章页与文档页传 article */
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	/** 背景动效的语义 key，具体效果见 src/lib/backdrops.ts */
	backdrop?: BackdropKey;
}

const { title, description, image, type, publishedTime, modifiedTime, backdrop } = Astro.props;
const backdropConfig = getBackdrop(backdrop);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			type={type}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
		/>
		<slot name="head" />
	</head>
	<body>
		{backdropConfig && <PageBackdrop config={backdropConfig} />}
		<Header />
		<slot />
		<Footer />
		<script>
			// 页面脚本由这里统一按 DOM 分发，页面本身不再各自挂 <script>
			import { initPage } from '../scripts/page';

			initPage();
		</script>
	</body>
</html>
