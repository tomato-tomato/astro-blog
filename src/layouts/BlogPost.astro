---
/*
 * 文章详情页布局。两种版式，由 frontmatter 的 `articleLayout` 决定：
 *
 *   post（默认）  正文 + 右侧大纲（吸顶，不随页面滚走）
 *   doc          左侧可折叠目录 + 正文 + 右侧大纲
 *
 * 宽度与页头对齐：main 由 global.css 统一给 max-width: --w-page + padding 1rem，
 * 这里只负责在内部切列。
 */
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import TagList from '../components/TagList.astro';
import ArticleOutline from '../components/ArticleOutline.astro';
import DocSidebar from '../components/DocSidebar.astro';
import { buildToc, type Heading } from '../lib/toc';
import { bookHref, getDocBooks, getPosts } from '../lib/posts';
import { Image } from 'astro:assets';

// 只声明布局真正用到的字段，而不是整份 schema：
// about.astro 复用本布局，不需要 tags / draft / articleLayout 等文章字段。
type Props = {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	tags?: string[];
	articleLayout?: 'post' | 'doc';
	/** 分类由 blog/[...slug].astro 传入（从目录推导）；about 不传 */
	category?: string;
	headings?: Heading[];
	/** 当前文章 id，用于在文档目录里标出「你在这里」 */
	postId?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags = [],
	articleLayout = 'post',
	headings = [],
	postId,
} = Astro.props;

const toc = buildToc(headings);
const hasToc = toc.length > 0;

// 文档版式才需要目录：分类 = 一本书，左栏只列当前这本，
// 保证点哪一篇都能原地切换（跨书就得整页跳）
const docBooks = articleLayout === 'doc' ? getDocBooks(await getPosts()) : [];
const book = docBooks.find((b) => b.name === category);
---

<BaseLayout
	title={title}
	description={description}
	image={heroImage}
	activeHref={articleLayout === 'doc' ? '/docs' : undefined}
>
	<main class="article-shell" data-layout={articleLayout} data-has-toc={hasToc}>
			{
				articleLayout === 'doc' && book && (
					<DocSidebar
						bookName={book.name}
						pages={book.posts}
						currentId={postId ?? ''}
						homeHref={bookHref(book.name)}
					/>
				)
			}

			<article class="article-main">
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}

				<header class="article-header">
					<h1 class="article-title">{title}</h1>
					<div class="article-meta">
						{category && <CategoryBadge name={category} />}
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="article-updated">
									更新于 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					{tags.length > 0 && <TagList tags={tags} class="article-tags" />}
				</header>

				<div class="prose">
					<slot />
				</div>
			</article>

			{hasToc && <ArticleOutline nodes={toc} />}
	</main>
</BaseLayout>

<style>
	/* ---------- 版式网格 ---------- */
	main.article-shell {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 12rem;
		gap: 2.5rem;
		align-items: start;
	}

	main.article-shell[data-has-toc='false'] {
		grid-template-columns: minmax(0, 1fr);
	}

	main.article-shell[data-layout='doc'] {
		grid-template-columns: 13rem minmax(0, 1fr) 11rem;
		gap: 2rem;
	}

	main.article-shell[data-layout='doc'][data-has-toc='false'] {
		grid-template-columns: 13rem minmax(0, 1fr);
	}

	/* 正文是主角：整块（封面 / 标题 / 正文）统一一个宽度并居中，
	   不随列宽变化 —— 否则会出现「封面 838、正文 704」这种参差。 */
	.article-main {
		width: 100%;
		max-width: 46rem;
		margin-inline: auto;
		transition: opacity 140ms var(--ease);
	}

	/* 文档版式原地换文章时，正文淡一下表示正在取下一篇 */
	main.article-shell[data-loading] .article-main {
		opacity: 0.4;
	}

	/* 文档版式下右侧大纲先让位，正文别被挤成窄条 */
	@media (max-width: 1180px) {
		main.article-shell[data-layout='doc'] {
			grid-template-columns: 13rem minmax(0, 1fr);
		}

		main.article-shell[data-layout='doc'] :global(.outline) {
			display: none;
		}
	}

	@media (max-width: 900px) {
		main.article-shell,
		main.article-shell[data-layout='doc'],
		main.article-shell[data-layout='doc'][data-has-toc='false'] {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.5rem;
		}

		/* 大纲 / 文档目录折叠块排到正文前面 */
		main.article-shell :global(.outline),
		main.article-shell :global(.doc-nav) {
			order: -1;
		}
	}

	/* ---------- 正文 ---------- */
	.hero-image {
		margin-bottom: 2.25rem;
	}

	.hero-image :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--r-lg);
	}

	.article-header {
		margin-bottom: 2.25rem;
	}

	.article-title {
		margin: 0;
		font-size: var(--t-title);
		line-height: var(--lh-tight);
		letter-spacing: -0.015em;
		color: var(--c-ink);
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-top: 1rem;
		font-size: var(--t-meta);
		color: var(--c-quiet);
	}

	.article-updated {
		padding-left: 0.75rem;
		border-left: 1px solid var(--c-line);
	}

	.article-tags {
		margin-top: 0.875rem;
	}

	.prose {
		font-size: var(--t-lead);
		line-height: var(--lh-copy);
		color: var(--c-body);
	}

	@media (max-width: 720px) {
		.article-title {
			font-size: 1.75rem;
		}

		.hero-image {
			margin-bottom: 1.5rem;
		}

		.article-header {
			margin-bottom: 1.5rem;
		}
	}
</style>
