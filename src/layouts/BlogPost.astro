---
/*
 * 文章详情页布局。
 *
 * 与首页 / 列表页的区别：
 *   - 标题左对齐（中文长标题居中很难看）
 *   - 日期移到标题下方
 *   - hero 图限宽到正文宽度、用 --r-lg 圆角、去掉重阴影
 * 正文宽度由 global.css 的 main 统一给（--w-article）。
 */
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import TagList from '../components/TagList.astro';
import { Image } from 'astro:assets';

// category 由 blog/[...slug].astro 传入（分类从目录推导）；
// about.astro 复用本布局时不传，所以是可选的。
type Props = CollectionEntry<'blog'>['data'] & {
	category?: string;
};

const { title, description, pubDate, updatedDate, heroImage, category, tags = [] } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}

				<header class="article-header">
					<h1 class="article-title">{title}</h1>
					<div class="article-meta">
						{category && <CategoryBadge name={category} />}
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="article-updated">
									更新于 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					{tags.length > 0 && <TagList tags={tags} class="article-tags" />}
				</header>

				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero-image {
		margin-bottom: 2.25rem;
	}

	.hero-image :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--r-lg);
	}

	.article-header {
		margin-bottom: 2.25rem;
	}

	.article-title {
		margin: 0;
		font-size: var(--t-title);
		line-height: var(--lh-tight);
		letter-spacing: -0.015em;
		color: var(--c-ink);
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-top: 1rem;
		font-size: var(--t-meta);
		color: var(--c-quiet);
	}

	.article-updated {
		padding-left: 0.75rem;
		border-left: 1px solid var(--c-line);
	}

	.article-tags {
		margin-top: 0.875rem;
	}

	.prose {
		font-size: var(--t-lead);
		line-height: var(--lh-copy);
		color: var(--c-body);
	}

	@media (max-width: 720px) {
		.article-title {
			font-size: 1.75rem;
		}

		.hero-image {
			margin-bottom: 1.5rem;
		}

		.article-header {
			margin-bottom: 1.5rem;
		}
	}
</style>
