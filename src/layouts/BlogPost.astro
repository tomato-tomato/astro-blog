---
/*
 * 普通文章布局：正文 + 右侧大纲（吸顶，不随页面滚走）。
 *
 * 文档版式在 DocPage.astro，两者共用 BaseLayout 与 ArticleBody。
 * 宽度与页头对齐：main 由 global.css 统一给 max-width: --w-page + padding 1rem，
 * 这里只负责在内部切列。
 */
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ArticleBody from '../components/ArticleBody.astro';
import ArticleOutline from '../components/ArticleOutline.astro';
import { buildToc, type Heading } from '../lib/toc';

// 只声明布局真正用到的字段；about.astro 复用本布局，不需要分类 / 标签。
type Props = {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	tags?: string[];
	/** 分类由 blog/[...slug].astro 传入（从目录推导）；about 不传 */
	category?: string;
	headings?: Heading[];
	/** Open Graph 类型；about 这类固定页传 website */
	type?: 'website' | 'article';
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags = [],
	headings = [],
	type = 'article',
} = Astro.props;

const toc = buildToc(headings);
const hasToc = toc.length > 0;
---

<BaseLayout
	title={title}
	description={description}
	image={heroImage}
	type={type}
	publishedTime={type === 'article' ? pubDate : undefined}
	modifiedTime={type === 'article' ? (updatedDate ?? pubDate) : undefined}
>
	<main class="article-shell" data-layout="post" data-has-toc={hasToc}>
		<ArticleBody
			title={title}
			pubDate={pubDate}
			updatedDate={updatedDate}
			heroImage={heroImage}
			category={category}
			tags={tags}
		>
			<slot />
		</ArticleBody>

		{hasToc && <ArticleOutline nodes={toc} />}
	</main>
</BaseLayout>

<style>
	main.article-shell {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 12rem;
		gap: 2.5rem;
		align-items: start;
	}

	main.article-shell[data-has-toc='false'] {
		grid-template-columns: minmax(0, 1fr);
	}

	@media (max-width: 900px) {
		main.article-shell {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.5rem;
		}

		/* 大纲折叠块排到正文前面 */
		main.article-shell :global(.outline) {
			order: -1;
		}
	}
</style>
