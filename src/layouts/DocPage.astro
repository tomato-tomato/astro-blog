---
/*
 * 文档阅读页布局：左侧文档册目录 + 正文，右侧大纲是浮动面板。
 *
 * 左侧目录是独立的 DocSidebar 组件（后续优化只改那里）；
 * 正文与普通文章共用 ArticleBody，避免两套 typography。
 * 大纲用 ArticleOutline 的 float 形态：贴在视口右侧、可收起，不挤占正文宽度。
 *
 * 文档页之间的「点左栏换正文」由 Astro 自带的 <ClientRouter /> 承担
 * （原来手写的 src/scripts/doc-reader.ts 已删除）。要点：
 *   - 只有本页引入 ClientRouter，所以**只有文档页之间**是原地换页；
 *     从文档页点去文章页 / 从别的页点进来，Astro 检测到目标页没有
 *     「astro-view-transitions-enabled」这个 meta，会自动整页跳转（源码
 *     astro/dist/transitions/router.js 里写明的行为），不会换出错版。
 *   - 换页时 <head> 由 Astro 逐元素 diff 更新，所以 canonical / og:url /
 *     og:title / twitter:title / <title> 都是对的，不需要手写同步。
 *   - 同页 #锚点跳转被 Astro 当成页内滚动处理，不会重新取页面
 *     —— 这正是当年手写版踩过的坑，交给官方实现更稳。
 *   - 换页后需要重新收集大纲、恢复折叠状态：见 src/scripts/article-outline.ts
 *     里对 astro:page-load 的监听。
 *
 * data-layout="doc" 仍保留：样式与 e2e 都靠它判定文档版式，不能删。
 */
import type { Heading } from '../lib/toc';
import { buildToc } from '../lib/toc';
import { resolveCover } from '../lib/covers';
import { bookHref, type Doc, type DocBook } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';
import ArticleBody from '../components/ArticleBody.astro';
import ArticleOutline from '../components/ArticleOutline.astro';
import DocSidebar from '../components/DocSidebar.astro';
// astro/components 的具名导出里没有 ClientRouter，只能按文件路径引
import ClientRouter from 'astro/components/ClientRouter.astro';

interface Props {
	book: DocBook;
	doc: Doc;
	headings?: Heading[];
}

const { book, doc, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage } = doc.data;
// 封面：作者手写优先，否则用按文档 id 生成的那张
const cover = resolveCover(doc.id, heroImage);

const toc = buildToc(headings);
const hasToc = toc.length > 0;
---

<BaseLayout
	title={title}
	description={description}
	image={cover}
	type="article"
	publishedTime={pubDate}
	modifiedTime={updatedDate ?? pubDate}
	backdrop="doc"
>
	<ClientRouter slot="head" />

	<main class="article-shell" data-layout="doc" data-has-toc={hasToc}>
		<DocSidebar
			bookName={book.name}
			nav={book.nav}
			currentId={doc.id}
			homeHref={bookHref(book.name)}
		/>

		<ArticleBody
			title={title}
			pubDate={pubDate}
			updatedDate={updatedDate}
			heroImage={cover}
		>
			<slot />
		</ArticleBody>

		{hasToc && <ArticleOutline nodes={toc} float />}
	</main>
</BaseLayout>

<style>
	/*
	 * 只有两列：左目录 + 正文。右侧大纲是浮动面板（见 ArticleOutline 的 float 形态），
	 * 不占网格宽度，所以正文能拿到 .article-main 的完整 50rem 上限。
	 * data-has-toc 仍然写，供样式与测试判断当前有没有大纲。
	 */
	main.article-shell {
		display: grid;
		grid-template-columns: 13rem minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
	}

	/* 窄屏：大纲退回文首折叠块，和左目录一起排到正文前面 */
	@media (max-width: 900px) {
		main.article-shell {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.5rem;
		}

		main.article-shell :global(.outline),
		main.article-shell :global(.doc-nav) {
			order: -1;
		}
	}
</style>
