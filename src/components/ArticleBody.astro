---
/*
 * 文章 / 文档共用的正文块：封面 + 标题元信息 + 正文插槽。
 *
 * 元信息固定两段时间：「发布于」取 pubDate，「最后修改于」取 updatedDate，
 * frontmatter 没写 updatedDate 时退回发布时间，保证每篇文章和文档都有修改时间。
 *
 * 只负责「一篇文章长什么样」，不关心页头、左右栏和 URL。
 * BlogPost 与 DocPage 各自决定外层网格，再把正文放进这里，
 * 避免两种版式复制同一套 typography。
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import CategoryBadge from './CategoryBadge.astro';
import TagList from './TagList.astro';

interface Props {
	title: string;
	pubDate: Date;
	/** 有更新就填这里；没有时最后修改时间退回发布时间 */
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	/** 文章分类；文档不传 */
	category?: string;
	tags?: string[];
}

const {
	title,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags = [],
} = Astro.props;

/** 文章页和文档页都要展示最后修改时间，没写 updatedDate 就用发布时间 */
const lastModified = updatedDate ?? pubDate;
---

<article class="article-main">
	{
		heroImage && (
			<div class="hero-image">
				<Image width={1020} height={510} src={heroImage} alt="" />
			</div>
		)
	}

	<header class="article-header">
		<h1 class="article-title">{title}</h1>
		<div class="article-meta">
			{category && <CategoryBadge name={category} />}
			<span class="article-published">
				发布于 <FormattedDate date={pubDate} />
			</span>
			<span class="article-updated">
				最后修改于 <FormattedDate date={lastModified} />
			</span>
		</div>
		{tags.length > 0 && <TagList tags={tags} class="article-tags" />}
	</header>

	<div class="prose">
		<slot />
	</div>
</article>

<style>
	.article-main {
		width: 100%;
		max-width: 46rem;
		margin-inline: auto;
		transition: opacity 140ms var(--ease);
	}

	/* 文档原地换文章时，正文淡一下表示正在取下一篇 */
	:global(main.article-shell[data-loading]) .article-main {
		opacity: 0.4;
	}

	.hero-image {
		margin-bottom: 2.25rem;
	}

	.hero-image :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--r-lg);
	}

	.article-header {
		margin-bottom: 2.25rem;
	}

	.article-title {
		margin: 0;
		font-size: var(--t-title);
		line-height: var(--lh-tight);
		letter-spacing: -0.015em;
		color: var(--c-ink);
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-top: 1rem;
		font-size: var(--t-meta);
		color: var(--c-quiet);
	}

	.article-published,
	.article-updated {
		white-space: nowrap;
	}

	.article-updated {
		padding-left: 0.75rem;
		border-left: 1px solid var(--c-line);
	}

	.article-tags {
		margin-top: 0.875rem;
	}

	.prose {
		font-size: var(--t-lead);
		line-height: var(--lh-copy);
		color: var(--c-body);
	}

	@media (max-width: 720px) {
		.article-title {
			font-size: 1.75rem;
		}

		.hero-image {
			margin-bottom: 1.5rem;
		}

		.article-header {
			margin-bottom: 1.5rem;
		}
	}
</style>
