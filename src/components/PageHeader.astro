---
/*
 * 分类页 / 标签页的标题区。
 */
interface Props {
	title: string;
	/** 标题右侧的小字，例如「3 篇文章」 */
	meta?: string;
	/** 返回上一级的链接 */
	backHref?: string;
	backText?: string;
}

const { title, meta, backHref, backText = '返回' } = Astro.props;
---

<header class="page-header">
	{
		backHref && (
			<a class="page-header-back" href={backHref}>
				← {backText}
			</a>
		)
	}
	<div class="page-header-row">
		<h1 class="page-header-title">{title}</h1>
		{meta && <span class="page-header-meta">{meta}</span>}
	</div>
</header>

<style>
	.page-header {
		margin-bottom: 2rem;
	}

	.page-header-back {
		display: inline-block;
		margin-bottom: 0.75rem;
		font-size: var(--t-small);
		color: var(--c-quiet);
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease);
	}

	.page-header-back:hover {
		color: var(--c-accent);
	}

	.page-header-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 0.75rem;
	}

	.page-header-title {
		margin: 0;
		font-size: var(--t-h1);
		line-height: var(--lh-tight);
		letter-spacing: -0.015em;
		color: var(--c-ink);
	}

	.page-header-meta {
		font-size: var(--t-small);
		color: var(--c-quiet);
	}
</style>
