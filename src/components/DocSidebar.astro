---
/*
 * 文档版式的左侧目录 —— 独立组件。
 *
 * 目录内容来自 src/content/docs/<文档册>/_nav.yaml：posts.ts 解析成 { title, items }
 * 后传进来。title 是顶部总标题，只渲染成纯文本；层级、缩进、折叠都由
 * DocNavTree 递归渲染。
 *
 * 本组件只负责外层容器、总标题、「总览」入口和窄屏折叠。
 * 后续对左侧目录的交互 / 信息层级优化都应该落在这里或 DocNavTree，
 * 不要把它重新写回 DocPage。
 */
import DocNavTree from './DocNavTree.astro';
import type { DocNav } from '../lib/doc-nav';

interface Props {
	bookName: string;
	/** 已校验、已组装的目录（总标题 + 树） */
	nav: DocNav;
	currentId: string;
	homeHref: string;
}

const { bookName, nav, currentId, homeHref } = Astro.props;
// 显示名统一取 nav.title（文档册显示名），data-book 仍保留册目录名作为机器标识
---

{
	nav.items.length > 0 && (
		<details class="doc-nav doc-sidebar" open data-book={bookName} data-doc-sidebar>
			<summary class="doc-nav-summary">{nav.title} · 目录</summary>
			<nav class="doc-nav-body" aria-label={`${nav.title} · 目录`}>
				<a class="doc-nav-home" href={homeHref}>
					<span aria-hidden="true">←</span> {nav.title} · 总览
				</a>
				<p class="doc-nav-title">{nav.title}</p>
				<DocNavTree nodes={nav.items} currentId={currentId} />
			</nav>
		</details>
	)
}

<style>
	.doc-nav {
		font-size: var(--t-small);
		line-height: var(--lh-dense);
	}

	.doc-nav-summary {
		display: none;
	}

	/* 顶部总标题：纯文本，不参与折叠；比第一层分组再大一档 */
	.doc-nav-title {
		margin: 0 0 0.5rem;
		padding: 0 0.55rem;
		color: var(--c-ink);
		font-size: var(--t-body);
		font-weight: var(--w-medium);
		line-height: var(--lh-tight);
		overflow-wrap: anywhere;
	}

	.doc-nav-home {
		display: block;
		margin-bottom: 0.25rem;
		padding: 0.25rem 0.55rem;
		border-radius: var(--r-sm);
		color: var(--c-muted);
		font-size: var(--t-meta);
		text-decoration: none;
		transition:
			color var(--dur-fast) var(--ease),
			background-color var(--dur-fast) var(--ease);
	}

	.doc-nav-home:hover {
		color: var(--c-accent);
		background: var(--c-soft);
	}

	/* ---------- 桌面端：吸顶，右侧细线分隔 ---------- */
	.doc-nav {
		position: sticky;
		top: calc(var(--header-h) + 1.5rem);
		max-height: calc(100svh - var(--header-h) - 3rem);
		overflow-y: auto;
		overscroll-behavior: contain;
		padding-right: 0.75rem;
		border-right: 1px solid var(--c-line);
	}

	.doc-nav::-webkit-scrollbar {
		width: 4px;
	}

	.doc-nav::-webkit-scrollbar-thumb {
		border-radius: 999px;
		background: var(--c-line);
	}

	/* ---------- 窄屏：折叠成文首的一个 details ---------- */
	@media (max-width: 900px) {
		.doc-nav {
			position: static;
			max-height: none;
			padding: 0;
			border-right: 0;
			border: 1px solid var(--c-line);
			border-radius: var(--r-md);
		}

		.doc-nav-summary {
			display: block;
			padding: 0.6rem 0.85rem;
			color: var(--c-ink);
			font-size: var(--t-ui);
			cursor: pointer;
			user-select: none;
		}

		.doc-nav-body {
			padding: 0 0.6rem 0.75rem;
		}
	}
</style>
