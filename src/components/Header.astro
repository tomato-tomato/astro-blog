---
/*
 * 站点页头。
 *
 * 结构参考 newechoes（lsy2246/newechoes）：
 *   固定顶栏 + 半透明毛玻璃背景层 + 居中的内容框 + 左侧 wordmark + 右侧操作区
 * 导航高亮沿用 newechoes 的「居中短下划线」形式，但用强调色而非纯黑。
 *
 * 导航文案目前是中文（首页 / 文章 / 分类 / 文档 / 时间轴 / 关于）。
 * 高亮统一由 HeaderLink 按 pathname 首段判断：/docs/... 高亮「文档」，
 * /blog/... 高亮「文章」，不再需要页面传 activeHref 特例。
 * 站点名取 consts.ts 的 SITE_TITLE（当前为「自留地」），改名只改那一处，页脚与 RSS 会跟着变。
 */
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';
import { SITE_TITLE } from '../consts';
import AvatarImage from '../assets/avatar.svg';
---

<header class="site-header">
	<div class="header-inner">
		<a href="/" class="site-brand">
			<span class="site-avatar">
				<img class="illustration-img" src={AvatarImage.src} alt="" width={754} height={800} />
			</span>
			<span class="site-wordmark" data-tooltip={SITE_TITLE}>{SITE_TITLE}</span>
		</a>

		<Search />

		<nav class="site-nav" aria-label="主导航">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/categories">分类</HeaderLink>
			<HeaderLink href="/docs">文档</HeaderLink>
			<HeaderLink href="/timeline">时间轴</HeaderLink>
			<HeaderLink href="/about">关于我</HeaderLink>
		</nav>

		<div class="header-actions">
			<a
				class="icon-button"
				href="https://github.com/tomato-tomato"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub"
			>
				<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		/* 半透明 + 毛玻璃：滚动时内容从底下透出来 */
		background: color-mix(in oklab, var(--c-bg) 88%, transparent);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid color-mix(in oklab, var(--c-line) 70%, transparent);
	}

	.header-inner {
		display: flex;
		align-items: center;
		gap: 1rem;
		width: 100%;
		max-width: var(--w-page);
		height: var(--header-h);
		margin: 0 auto;
		padding: 0 1rem;
	}

	.site-brand {
		display: flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.55rem;
		color: var(--c-ink);
		text-decoration: none;
		transition: opacity var(--dur-fast) var(--ease);
	}

	.site-brand:hover {
		opacity: 0.72;
		color: var(--c-ink);
	}

	.site-avatar {
		flex: 0 0 auto;
		width: 36px;
		height: 36px;
		overflow: hidden;
		border-radius: var(--r-sm);
	}

	/* contain 而不是 cover：完整展示整张图，不做裁切。
	   图片自带白底，暗色模式下由 .illustration-img 的滤镜反转。 */
	.site-avatar :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 0;
		object-fit: contain;
	}

	.site-wordmark {
		font-size: 1.125rem;
		font-weight: var(--w-bold);
		letter-spacing: -0.015em;
		white-space: nowrap;
	}

	/* 搜索组件带 margin-left: auto，由它吸收空白把右侧内容推过去 */
	.site-nav {
		display: flex;
		align-items: center;
		align-self: stretch;
		min-width: 0;
		margin-left: 0.5rem;
	}

	.header-actions {
		display: flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.25rem;
		margin-left: 0.5rem;
		padding-left: 0.75rem;
		border-left: 1px solid var(--c-line);
	}

	.icon-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border-radius: var(--r-sm);
		color: var(--c-quiet);
		text-decoration: none;
		transition:
			color var(--dur-fast) var(--ease),
			background-color var(--dur-fast) var(--ease);
	}

	.icon-button:hover {
		color: var(--c-ink);
		background: var(--c-soft-strong);
	}

	@media (max-width: 720px) {
		.header-inner {
			gap: 0.5rem;
			padding: 0 0.75rem;
		}

		.site-brand {
			gap: 0.4rem;
		}

		.site-avatar {
			width: 30px;
			height: 30px;
		}

		/* 站点名可能很长，窄屏截断；完整文本走全局 data-tooltip */
		.site-wordmark {
			display: block;
			min-width: 0;
			max-width: 6.5rem;
			overflow: hidden;
			font-size: 1rem;
			white-space: nowrap;
			text-overflow: ellipsis;
		}

		/* 窄屏放不下 5 个导航项时横向滚动，而不是换行把页头撑高 */
		.site-nav {
			overflow-x: auto;
			scrollbar-width: none;
		}

		.site-nav::-webkit-scrollbar {
			display: none;
		}

		.header-actions {
			margin-left: 0.25rem;
			padding-left: 0.5rem;
		}
	}

	/* 手机窄屏：站名文字与 GitHub 图标让位，把宽度留给导航 */
	@media (max-width: 560px) {
		.site-wordmark {
			display: none;
		}

		.header-actions .icon-button {
			display: none;
		}

		.header-actions {
			padding-left: 0.4rem;
		}
	}
</style>
