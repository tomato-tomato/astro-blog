---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
import { socialImage } from '../lib/covers';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** Open Graph 类型：文章/文档用 article，其余页面用 website */
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	// 没传封面时用生成的社交图；连它也没有（尚未跑过 prebuild）就整条省略 og:image
	image = socialImage,
	type = 'website',
	publishedTime,
	modifiedTime,
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" id="theme-color" content="#ffffff" />
<script is:inline>
	// 主题必须在首次绘制前定好，否则暗色模式会先白闪一下。
	// 这里必须是 is:inline —— Astro 默认会把 <script> 打包成模块并延迟执行，那样一定会闪。
	(() => {
		const root = document.documentElement;

		/** 用户存过的优先，没存过听系统的 prefers-color-scheme */
		const decide = () => {
			let theme = null;
			try {
				theme = localStorage.getItem('theme');
			} catch {
				/* 隐私模式下 localStorage 不可用，走系统偏好即可 */
			}
			if (theme !== 'light' && theme !== 'dark') {
				theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			}
			return theme;
		};

		const apply = () => {
			const theme = decide();
			root.dataset.theme = theme;
			const meta = document.getElementById('theme-color');
			if (meta) meta.setAttribute('content', theme === 'dark' ? '#111315' : '#ffffff');
		};

		apply();

		// load 之后再打开颜色过渡，避免首屏加载时闪一下
		const markReady = () => root.classList.add('theme-ready');
		if (document.readyState === 'complete') markReady();
		else window.addEventListener('load', markReady, { once: true });

		/*
		 * 文档页换页（<ClientRouter />）会把新页面 <html> 上的属性搬到当前节点，
		 * 于是 data-theme 和 theme-ready 这些**运行时写上去**的属性会被静态 HTML 抹掉 ——
		 * 表现是暗色模式下点一下左栏就掉回亮色。astro:after-swap 在 DOM 换完、浏览器绘制前
		 * 派发，这里同步补回来，看不到中间态。theme-color 也是同理：它是个 meta，
		 * 换页时被新页面的静态值（#ffffff）覆盖，所以一并重设。
		 */
		document.addEventListener('astro:after-swap', () => {
			apply();
			if (document.readyState === 'complete') markReady();
		});
	})();
</script>
<!-- 站点图标：来自 src/assets/avatar.svg（undraw_ideas，透明底）。
     SVG 版给支持它的浏览器（任意尺寸都清晰），PNG 三档做兜底。 -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image.src, Astro.url)} />}
{
	type === 'article' && publishedTime && (
		<meta property="article:published_time" content={publishedTime.toISOString()} />
	)
}
{
	type === 'article' && modifiedTime && (
		<meta property="article:modified_time" content={modifiedTime.toISOString()} />
	)
}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{image && <meta property="twitter:image" content={new URL(image.src, Astro.url)} />}
