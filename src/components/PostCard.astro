---
/*
 * 文章卡片。列表页 / 分类页 / 标签页 / 首页共用。
 *
 * 只是把 Post 映射到 ContentCard 的中性字段，外观与交互全在 ContentCard 里。
 */
import ContentCard from './ContentCard.astro';
import { getCategory, postHref, type Article } from '../lib/posts';

interface Props {
	post: Article;
	/** 不显示封面图 */
	hideImage?: boolean;
	/** 不显示摘要 */
	hideDescription?: boolean;
	/** 标签最多显示几个，0 表示不显示标签 */
	maxTags?: number;
	/** 分类徽章旁的中性标记，如「文档册 · 2 篇」 */
	badge?: string;
	/** 覆盖链接的无障碍名称；不传则由标题等内容自然生成 */
	ariaLabel?: string;
}

const {
	post,
	hideImage = false,
	hideDescription = false,
	maxTags = 3,
	badge,
	ariaLabel,
} = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;
---

<ContentCard
	href={postHref(post)}
	title={title}
	description={description}
	image={heroImage}
	category={getCategory(post)}
	badge={badge}
	date={pubDate}
	tags={tags}
	hideImage={hideImage}
	hideDescription={hideDescription}
	maxTags={maxTags}
	ariaLabel={ariaLabel}
/>
