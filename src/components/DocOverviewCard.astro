---
/*
 * 文档册入口卡片。
 *
 * 标题 / 封面 / 简介来自 src/content/docs/<文档册>/_book.md，而不是第一篇文档；
 * 点击直达第一篇文档，左侧目录会以第一篇为当前项。
 */
import ContentCard from './ContentCard.astro';
import { docBookHref, type DocBook } from '../lib/posts';

interface Props {
	book: DocBook;
}

const { book } = Astro.props;
const { title, description, heroImage } = book.meta.data;
const count = book.docs.length;
const href = docBookHref(book); // 空文档册会在数据层直接报错
const first = book.docs[0]!;
---

<ContentCard
	href={href}
	title={title}
	description={description}
	image={heroImage}
	badge={`文档册 · ${count} 篇`}
	ariaLabel={`${title}：共 ${count} 篇文档，从《${first.data.title}》开始阅读`}
/>
