---
/*
 * 文章大纲（右侧）。
 *
 * 桌面端 sticky 吸在视口里，不随页面滚走；窄屏折叠成文首的一个 <details>。
 * 标题过长时单行省略，完整文本走 title 属性。
 * 高亮由 BlogPost.astro 里的滚动监听负责（只认 [data-outline] a）。
 */
import type { TocNode } from '../lib/toc';

interface Props {
	nodes: TocNode[];
}

const { nodes } = Astro.props;
---

{
	nodes.length > 0 && (
		<details class="outline" open data-outline>
			<summary class="outline-summary">本文目录</summary>
			<nav class="outline-nav" aria-label="本文目录">
				<ol class="outline-list">
					{nodes.map((node) => (
						<li>
							<a href={`#${node.slug}`} title={node.text} data-toc-link>
								{node.text}
							</a>
							{node.children.length > 0 && (
								<ol class="outline-sub">
									{node.children.map((child) => (
										<li>
											<a href={`#${child.slug}`} title={child.text} data-toc-link>
												{child.text}
											</a>
										</li>
									))}
								</ol>
							)}
						</li>
					))}
				</ol>
			</nav>
		</details>
	)
}

<style>
	.outline {
		font-size: var(--t-small);
		line-height: var(--lh-dense);
		/* 大纲只是辅助，别抢正文的视线 */
		color: var(--c-quiet);
	}

	.outline-summary {
		display: none;
	}

	.outline-list,
	.outline-sub {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.outline-list > li + li {
		margin-top: 0.15rem;
	}

	.outline a {
		display: block;
		padding: 0.15rem 0.45rem;
		border-left: 2px solid transparent;
		color: var(--c-quiet);
		text-decoration: none;
		/* 标题过长就省略，完整文本走 title 提示，别把大纲撑宽 */
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		transition:
			color var(--dur-fast) var(--ease),
			border-color var(--dur-fast) var(--ease);
	}

	.outline a:hover {
		color: var(--c-ink);
	}

	/* 当前阅读位置：强调色 + 左侧竖条 */
	.outline a[data-active] {
		border-left-color: var(--c-accent);
		color: var(--c-accent);
	}

	.outline-sub {
		padding-left: 0.6rem;
	}

	.outline-sub a {
		font-size: var(--t-meta);
	}

	/* ---------- 桌面端吸顶 ---------- */
	.outline {
		position: sticky;
		top: calc(var(--header-h) + 1.5rem);
		max-height: calc(100svh - var(--header-h) - 3rem);
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	/* 滚动条收窄，别抢视线 */
	.outline::-webkit-scrollbar {
		width: 4px;
	}

	.outline::-webkit-scrollbar-thumb {
		border-radius: 999px;
		background: var(--c-line);
	}

	/* ---------- 窄屏：折叠成文首的一个 details ---------- */
	@media (max-width: 900px) {
		.outline {
			position: static;
			max-height: none;
			padding: 0;
			border: 1px solid var(--c-line);
			border-radius: var(--r-md);
		}

		.outline-summary {
			display: block;
			padding: 0.6rem 0.85rem;
			color: var(--c-ink);
			font-size: var(--t-ui);
			cursor: pointer;
			user-select: none;
		}

		.outline-nav {
			padding: 0 0.35rem 0.6rem;
		}

		.outline a {
			padding: 0.35rem 0.5rem;
		}
	}
</style>
