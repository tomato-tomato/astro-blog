---
/*
 * 页头搜索。
 *
 * 数据来自构建期生成的 /search.json（见 src/pages/search.json.js），
 * 第一次用到时才 fetch，不占首屏。
 *
 * 两种形态：
 *   ≥ 900px  输入框直接排在页头里（.search-panel 常驻）
 *   < 900px  只显示一个放大镜按钮，点击后整条搜索栏从页头下方展开
 * 两种形态共用同一套 JS 与结果面板。
 */
---

<div class="site-search" data-search>
	<button
		class="search-trigger"
		type="button"
		aria-label="搜索文章"
		aria-expanded="false"
		data-search-trigger
	>
		<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
			<circle cx="11" cy="11" r="7"></circle>
			<path d="m20 20-3.5-3.5"></path>
		</svg>
	</button>

	<div class="search-panel" data-search-panel>
		<div class="search-field">
			<svg
				class="search-field-icon"
				viewBox="0 0 24 24"
				width="16"
				height="16"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<circle cx="11" cy="11" r="7"></circle>
				<path d="m20 20-3.5-3.5"></path>
			</svg>
			<input
				class="search-input"
				type="search"
				placeholder="搜索文章…"
				aria-label="搜索文章"
				autocomplete="off"
				data-search-input
			/>
			<ul class="search-results" data-search-results hidden></ul>
		</div>
	</div>
</div>

<style>
	.site-search {
		position: relative;
		flex: 0 1 auto;
		min-width: 0;
		margin-left: auto;
	}

	/* 窄屏：只显示放大镜按钮 */
	.search-trigger {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		padding: 0;
		border: 1px solid transparent;
		border-radius: var(--r-sm);
		background: transparent;
		color: var(--c-quiet);
		cursor: pointer;
		transition:
			color var(--dur-fast) var(--ease),
			background-color var(--dur-fast) var(--ease),
			border-color var(--dur-fast) var(--ease);
	}

	.search-trigger:hover {
		color: var(--c-ink);
		background: var(--c-soft-strong);
		border-color: var(--c-line);
	}

	/* 窄屏：搜索栏从页头下方整条展开 */
	.search-panel {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		display: none;
		padding: 0.6rem 1rem 0.8rem;
		border-bottom: 1px solid var(--c-line);
		background: var(--c-bg);
	}

	.site-search[data-open] .search-panel {
		display: block;
	}

	.search-field {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.search-field-icon {
		flex: 0 0 auto;
		color: var(--c-quiet);
	}

	.search-input {
		width: 100%;
		min-width: 0;
		padding: 0.4rem 0.6rem;
		border: 1px solid var(--c-line);
		border-radius: var(--r-md);
		background: transparent;
		color: var(--c-ink);
		font-family: inherit;
		font-size: var(--t-ui);
		transition:
			border-color var(--dur-fast) var(--ease),
			box-shadow var(--dur-fast) var(--ease);
	}

	.search-input::placeholder {
		color: var(--c-quiet);
	}

	.search-input:focus {
		outline: none;
		border-color: var(--c-line-strong);
		box-shadow: inset 0 0 0 1px var(--c-line-strong);
	}

	/* ---------- 结果面板 ---------- */
	.search-results {
		position: absolute;
		top: calc(100% + 0.4rem);
		left: 0;
		right: 0;
		z-index: 60;
		max-height: min(60vh, 26rem);
		margin: 0;
		padding: 0.35rem;
		overflow-y: auto;
		list-style: none;
		border: 1px solid var(--c-line);
		border-radius: var(--r-md);
		background: var(--c-bg);
		box-shadow: var(--shadow-soft);
	}

	.search-results a {
		display: block;
		padding: 0.5rem 0.6rem;
		border-radius: var(--r-sm);
		color: inherit;
		text-decoration: none;
	}

	.search-results a:hover,
	.search-results a[data-active] {
		background: var(--c-soft-strong);
	}

	.search-result-title {
		display: block;
		font-size: var(--t-ui);
		color: var(--c-ink);
		overflow-wrap: anywhere;
	}

	.search-result-meta {
		display: block;
		margin-top: 0.15rem;
		font-size: var(--t-meta);
		color: var(--c-quiet);
	}

	.search-empty {
		padding: 0.6rem;
		font-size: var(--t-small);
		color: var(--c-quiet);
	}

	/* 宽屏：输入框常驻在页头里 */
	@media (min-width: 900px) {
		.site-search {
			/* 关键：这里必须保持 auto —— 由它吸收页头的剩余空白，
			   把搜索框、导航、右侧操作区一起推到右边。
			   一旦改成固定值，整条页头就会全部挤到左侧（之前踩过）。 */
			margin-left: auto;
			margin-right: 0.5rem;
			width: clamp(10rem, 16vw, 15rem);
		}

		.search-trigger {
			display: none;
		}

		.search-panel {
			position: static;
			display: block;
			padding: 0;
			border: 0;
			background: transparent;
		}

		.search-field-icon {
			position: absolute;
			left: 0.55rem;
			pointer-events: none;
		}

		.search-input {
			padding-left: 2rem;
		}
	}
</style>

