---
/*
 * 单个分类的文章列表。
 * 分类由目录推导，见 src/lib/posts.ts 的 getCategory()。
 *
 * 文档是并列内容，不属于文章分类；文档入口在 /docs/ 与分类总览的文档块。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_TITLE } from '../../consts';
import { getArticles, groupByCategory, type Article } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getArticles();
	return groupByCategory(posts).map(({ name, posts }) => ({
		params: { category: name },
		props: { category: name, posts },
	}));
}

interface Props {
	category: string;
	posts: Article[];
}

const { category, posts } = Astro.props;
---

<BaseLayout
	title={`分类：${category} | ${SITE_TITLE}`}
	description={`${SITE_TITLE} 中「${category}」分类下的全部文章，共 ${posts.length} 篇。`}
	backdrop="categoryDetail"
>
	<main>
		<PageHeader
			title={category}
			meta={`共 ${posts.length} 篇文章`}
			backHref="/categories"
			backText="全部分类"
		/>
		<ul class="post-grid">
			{posts.map((post) => (
				<li>
					<PostCard post={post} />
				</li>
			))}
		</ul>
	</main>
</BaseLayout>
