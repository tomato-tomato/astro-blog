---
/*
 * 分类页。
 *
 * 文章分类与文档是两种并列内容：
 *   - 上方 chips 与文章列表只统计普通文章；
 *   - 文档单独成块，每一册一张入口卡，不参与文章分类筛选。
 *
 * 这里选中某个分类时不跳转，只改 ?c=，方便分享与刷新后保持选中。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import DocOverviewCard from '../../components/DocOverviewCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getArticles, getCategory, getDocBooks, groupByCategory } from '../../lib/posts';

const articles = await getArticles();
const categories = groupByCategory(articles);
const books = await getDocBooks();
const total = articles.length;
---

<BaseLayout title={`分类 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} backdrop="categoryIndex">
	<main>
		<PageHeader title="分类" meta={`共 ${categories.length} 个分类 · ${total} 篇文章`} />

		{books.length > 0 && (
			<section class="docs-section" aria-label="文档">
				<div class="section-head">
					<h2>文档</h2>
					<a href="/docs">全部文档 →</a>
				</div>
				<ul class="post-grid">
					{books.map((book) => (
						<li>
							<DocOverviewCard book={book} />
						</li>
					))}
				</ul>
			</section>
		)}

		{
			categories.length > 0 ? (
				<>
					<div class="filter" role="group" aria-label="按分类筛选" data-filter>
						<button class="chip" type="button" data-category="" aria-pressed="true">
							全部
							<span class="chip-count">{total}</span>
						</button>
						{categories.map((category) => (
							<button
								class="chip"
								type="button"
								data-category={category.name}
								aria-pressed="false"
							>
								{category.name}
								<span class="chip-count">{category.count}</span>
							</button>
						))}
					</div>

					<ul class="post-grid" data-post-list>
						{articles.map((post) => (
							<li data-category={getCategory(post)}>
								<PostCard post={post} />
							</li>
						))}
					</ul>

					<p class="filter-empty" data-filter-empty hidden>
						这个分类下还没有文章。
					</p>
				</>
			) : (
				<p>还没有分类。</p>
			)
		}
	</main>
</BaseLayout>

<style>
	.filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35rem 0.7rem;
		border: 1px solid var(--c-line);
		border-radius: 999px;
		background: transparent;
		color: var(--c-muted);
		font-family: inherit;
		font-size: var(--t-ui);
		cursor: pointer;
		transition:
			color var(--dur-fast) var(--ease),
			border-color var(--dur-fast) var(--ease),
			background-color var(--dur-fast) var(--ease);
	}

	.chip:hover {
		border-color: var(--c-line-strong);
		color: var(--c-ink);
	}

	.chip[aria-pressed='true'] {
		border-color: var(--c-accent);
		background: var(--c-accent);
		color: var(--c-accent-ink);
	}

	.chip-count {
		font-size: var(--t-meta);
		color: var(--c-quiet);
		font-variant-numeric: tabular-nums;
		transition: color var(--dur-fast) var(--ease);
	}

	.chip[aria-pressed='true'] .chip-count {
		color: color-mix(in oklab, var(--c-accent-ink) 75%, transparent);
	}

	.docs-section {
		margin-bottom: 2.5rem;
	}

	.section-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		margin-bottom: 0.9rem;
	}

	.section-head h2 {
		margin: 0;
		font-size: var(--t-h3);
		color: var(--c-ink);
	}

	.section-head a {
		font-size: var(--t-small);
		color: var(--c-quiet);
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease);
	}

	.section-head a:hover {
		color: var(--c-accent);
	}

	.filter-empty {
		margin: 2rem 0;
		color: var(--c-quiet);
	}
</style>
