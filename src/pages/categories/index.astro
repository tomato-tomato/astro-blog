---
/*
 * 分类页。
 *
 * 上下两段：
 *   上  可点击的分类标签（含「全部」），点击即筛选
 *   下  文章列表（一次性全渲染，前端按 data-category 显隐）
 *
 * 文档文章不逐篇出现：所有文档都在「文档」分类下，只出一张总入口卡片，
 * 标题 / 封面 / 简介来自 src/content/docs/overview.md，点击直达第一篇文档。
 * 文章里的分类徽章仍然链到 /categories/<分类>，那条路径不变。
 * 这里选中某个分类时不跳转，只改 ?c=，方便分享与刷新后保持选中。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import DocOverviewCard from '../../components/DocOverviewCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCategoryIndexView } from '../../lib/category-view';
import { DOC_CATEGORY, getCategory } from '../../lib/posts';

const { categories, total, articles, docEntry } = await getCategoryIndexView();
---

<BaseLayout title={`分类 | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main>
		<PageHeader title="分类" meta={`共 ${categories.length} 个分类 · ${total} 篇文章`} />

		{
			categories.length > 0 ? (
				<>
					<div class="filter" role="group" aria-label="按分类筛选" data-filter>
						<button class="chip" type="button" data-category="" aria-pressed="true">
							全部
							<span class="chip-count">{total}</span>
						</button>
						{categories.map((c) => (
							<button class="chip" type="button" data-category={c.name} aria-pressed="false">
								{c.name}
								<span class="chip-count">{c.count}</span>
							</button>
						))}
					</div>

					<ul class="post-grid" data-post-list>
						{
							docEntry && (
								<li data-category={DOC_CATEGORY}>
									<DocOverviewCard overview={docEntry.overview} book={docEntry.book} />
								</li>
							)
						}
						{
							articles.map((post) => (
								<li data-category={getCategory(post)}>
									<PostCard post={post} />
								</li>
							))
						}
					</ul>

					<p class="filter-empty" data-filter-empty hidden>
						这个分类下还没有文章。
					</p>
				</>
			) : (
				<p>还没有分类。</p>
			)
		}
	</main>
</BaseLayout>

<style>
	.filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35rem 0.7rem;
		border: 1px solid var(--c-line);
		border-radius: 999px;
		background: transparent;
		color: var(--c-muted);
		font-family: inherit;
		font-size: var(--t-ui);
		cursor: pointer;
		transition:
			color var(--dur-fast) var(--ease),
			border-color var(--dur-fast) var(--ease),
			background-color var(--dur-fast) var(--ease);
	}

	.chip:hover {
		border-color: var(--c-line-strong);
		color: var(--c-ink);
	}

	.chip[aria-pressed='true'] {
		border-color: var(--c-accent);
		background: var(--c-accent);
		color: var(--c-accent-ink);
	}

	.chip-count {
		font-size: var(--t-meta);
		color: var(--c-quiet);
		font-variant-numeric: tabular-nums;
		transition: color var(--dur-fast) var(--ease);
	}

	.chip[aria-pressed='true'] .chip-count {
		color: color-mix(in oklab, var(--c-accent-ink) 75%, transparent);
	}

	.filter-empty {
		margin: 2rem 0;
		color: var(--c-quiet);
	}
</style>
