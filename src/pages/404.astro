---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`Page not found | ${SITE_TITLE}`} description="404 - Page not found" backdrop="notFound">
	<meta slot="head" name="robots" content="noindex" />
	<main>
		<h1>404 - Page not found</h1>
		<p>
			这个地址下没有内容。可以回到 <a href="/">首页</a>，或者看看
			<a href="/blog/">全部文章</a>。
		</p>
	</main>
</BaseLayout>
