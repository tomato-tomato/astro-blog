---
/*
 * 标签云。字号按文章数加权 —— 出现越多的标签字号越大。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getArticles, groupByTag } from '../../lib/posts';

const posts = await getArticles();
const tags = groupByTag(posts);

const counts = tags.map((t) => t.count);
const maxCount = counts.length ? Math.max(...counts) : 1;
const minCount = counts.length ? Math.min(...counts) : 1;

/** 线性插值出字号：最少 → 0.9rem，最多 → 1.5rem */
function fontSizeOf(count: number): string {
	if (maxCount === minCount) return '1.1rem';
	const ratio = (count - minCount) / (maxCount - minCount);
	return `${(0.9 + ratio * 0.6).toFixed(3)}rem`;
}
---

<BaseLayout title={`标签 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} backdrop="tagIndex">
	<main>
		<PageHeader title="标签" meta={`共 ${tags.length} 个`} />
		{
			tags.length > 0 ? (
				<ul class="tag-cloud">
					{tags.map((t) => (
						<li>
							<a
								class="tag-cloud-item"
								href={`/tags/${t.name}`}
								style={`--tag-size: ${fontSizeOf(t.count)}`}
							>
								{t.name}
								<span class="tag-cloud-count">{t.count}</span>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p>还没有标签。</p>
			)
		}
	</main>
</BaseLayout>

<style>
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 0.9rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tag-cloud-item {
		display: inline-flex;
		align-items: baseline;
		gap: 0.35rem;
		font-size: var(--tag-size, 1rem);
		color: var(--c-muted);
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease);
	}

	.tag-cloud-item:hover {
		color: var(--c-accent);
	}

	.tag-cloud-count {
		font-size: var(--t-meta);
		color: var(--c-quiet);
	}
</style>
