---
/*
 * 单册文档的目录页：/docs/<文档册>/
 *
 * 文档页左栏的「总览」指向这里。
 * 顺序由每篇文档 frontmatter 的 order 决定（小的在前），
 * 同序再按发布时间。
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../../consts';
import { docHref, getDocBooks, type DocBook } from '../../../lib/posts';

export async function getStaticPaths() {
	const books = await getDocBooks();
	return books.map((book) => ({
		params: { book: book.name },
		props: { book },
	}));
}

interface Props {
	book: DocBook;
}

const { book } = Astro.props;
const { title, description } = book.meta.data;
---

<BaseLayout
	title={`${title} · 文档 | ${SITE_TITLE}`}
	description={description}
>
	<main>
		<PageHeader
			title={title}
			meta={`文档册 · 共 ${book.docs.length} 篇`}
			backHref="/docs"
			backText="全部文档"
		/>

		<p class="book-description">{description}</p>

		<ol class="doc-index">
			{
				book.docs.map((doc, i) => (
					<li>
						<a href={docHref(doc)}>
							<span class="doc-index-no">{String(i + 1).padStart(2, '0')}</span>
							<span class="doc-index-main">
								<span class="doc-index-title">{doc.data.title}</span>
								<span class="doc-index-desc" data-tooltip={doc.data.description}>{doc.data.description}</span>
								<span class="doc-index-date">
									<FormattedDate date={doc.data.pubDate} />
								</span>
							</span>
						</a>
					</li>
				))
			}
		</ol>

		<p class="doc-index-hint">
			顺序由每篇文档 frontmatter 的 <code>order</code> 决定，改数字即可重排。
		</p>
	</main>
</BaseLayout>

<style>
	.book-description {
		max-width: 42rem;
		margin: -0.5rem 0 2rem;
		color: var(--c-muted);
		font-size: var(--t-small);
		line-height: var(--lh-copy);
	}

	.doc-index {
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: none;
	}

	.doc-index li + li {
		border-top: 1px solid var(--c-line);
	}

	.doc-index a {
		display: flex;
		gap: 1.25rem;
		padding: 1.1rem 0.25rem;
		color: inherit;
		text-decoration: none;
		transition: background-color var(--dur-fast) var(--ease);
	}

	.doc-index a:hover {
		background: var(--c-soft);
	}

	.doc-index-no {
		flex: 0 0 auto;
		padding-top: 0.15rem;
		color: var(--c-quiet);
		font-family: var(--font-mono);
		font-size: var(--t-small);
		font-variant-numeric: tabular-nums;
	}

	.doc-index-main {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.doc-index-title {
		color: var(--c-ink);
		font-size: var(--t-card-title);
		font-weight: var(--w-medium);
		transition: color var(--dur-fast) var(--ease);
	}

	.doc-index a:hover .doc-index-title {
		color: var(--c-accent);
	}

	.doc-index-desc {
		color: var(--c-muted);
		font-size: var(--t-small);
		line-height: var(--lh-dense);
		overflow: hidden;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 1;
	}

	.doc-index-date {
		color: var(--c-quiet);
		font-size: var(--t-meta);
	}

	.doc-index-hint {
		margin-top: 2rem;
		color: var(--c-quiet);
		font-size: var(--t-small);
	}

	.doc-index-hint code {
		font-size: 0.9em;
	}
</style>
