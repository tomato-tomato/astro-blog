---
/*
 * 文档集总入口：/docs/<分类>/
 *
 * 一本「书」= 一个分类下所有 articleLayout: doc 的文章，按 docOrder 排。
 * 这里是编排目录的地方：改 frontmatter 的 docOrder 就能调整顺序。
 */
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { getDocBooks, getPosts, postHref, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	const books = getDocBooks(await getPosts());
	return books.map(({ name, posts }) => ({
		params: { book: name },
		props: { name, posts },
	}));
}

interface Props {
	name: string;
	posts: Post[];
}

const { name, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${name} · 文档 | ${SITE_TITLE}`}
			description={`${name} 文档集，共 ${posts.length} 篇。`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<PageHeader title={name} meta={`文档集 · 共 ${posts.length} 篇`} backHref="/docs" backText="全部文档" />

			<ol class="doc-index">
				{
					posts.map((post, i) => (
						<li>
							<a href={postHref(post)}>
								<span class="doc-index-no">{String(i + 1).padStart(2, '0')}</span>
								<span class="doc-index-main">
									<span class="doc-index-title">{post.data.title}</span>
									<span class="doc-index-desc">{post.data.description}</span>
									<span class="doc-index-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</span>
							</a>
						</li>
					))
				}
			</ol>

			<p class="doc-index-hint">
				顺序由每篇文章 frontmatter 的 <code>docOrder</code> 决定，改数字即可重排。
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.doc-index {
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: none;
	}

	.doc-index li + li {
		border-top: 1px solid var(--c-line);
	}

	.doc-index a {
		display: flex;
		gap: 1.25rem;
		padding: 1.1rem 0.25rem;
		color: inherit;
		text-decoration: none;
		transition: background-color var(--dur-fast) var(--ease);
	}

	.doc-index a:hover {
		background: var(--c-soft);
	}

	.doc-index-no {
		flex: 0 0 auto;
		padding-top: 0.15rem;
		color: var(--c-quiet);
		font-family: var(--font-mono);
		font-size: var(--t-small);
		font-variant-numeric: tabular-nums;
	}

	.doc-index-main {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.doc-index-title {
		color: var(--c-ink);
		font-size: var(--t-card-title);
		font-weight: var(--w-medium);
		transition: color var(--dur-fast) var(--ease);
	}

	.doc-index a:hover .doc-index-title {
		color: var(--c-accent);
	}

	.doc-index-desc {
		color: var(--c-muted);
		font-size: var(--t-small);
		line-height: var(--lh-dense);
		overflow: hidden;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 1;
	}

	.doc-index-date {
		color: var(--c-quiet);
		font-size: var(--t-meta);
	}

	.doc-index-hint {
		margin-top: 2rem;
		color: var(--c-quiet);
		font-size: var(--t-small);
	}

	.doc-index-hint code {
		font-size: 0.9em;
	}
</style>
