---
/*
 * 全部文档集：/docs/
 *
 * 每本「书」= 一个分类下的 doc 版式文章。这里只是索引，
 * 具体目录在 /docs/<分类>/。
 */
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { bookHref, getDocBooks, getPosts, postHref } from '../../lib/posts';

const books = getDocBooks(await getPosts());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`文档 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<PageHeader title="文档" meta={`共 ${books.length} 个文档集`} />

			{
				books.length > 0 ? (
					<ul class="book-grid">
						{books.map((book) => (
							<li>
								<article class="book-card">
									<a class="book-card-head" href={bookHref(book.name)}>
										<h2>{book.name}</h2>
										<span class="book-card-count">{book.posts.length} 篇</span>
									</a>
									<ol class="book-card-list">
										{book.posts.slice(0, 4).map((post) => (
											<li>
												<a href={postHref(post)}>{post.data.title}</a>
											</li>
										))}
									</ol>
								</article>
							</li>
						))}
					</ul>
				) : (
					<p>还没有文档集。给文章加上 <code>articleLayout: doc</code> 就会出现。</p>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.book-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.book-card {
		height: 100%;
		padding: 1.1rem 1.2rem 1rem;
		border: 1px solid var(--c-line);
		border-radius: var(--r-md);
		transition: border-color var(--dur-fast) var(--ease);
	}

	.book-card:hover {
		border-color: var(--c-line-strong);
	}

	.book-card-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		color: var(--c-ink);
		text-decoration: none;
	}

	.book-card-head h2 {
		margin: 0;
		font-size: var(--t-h3);
	}

	.book-card-count {
		color: var(--c-quiet);
		font-size: var(--t-meta);
		white-space: nowrap;
	}

	.book-card-list {
		margin: 0.75rem 0 0;
		padding-left: 1.1rem;
		color: var(--c-muted);
		font-size: var(--t-small);
		line-height: 1.9;
	}

	.book-card-list a {
		color: inherit;
		text-decoration: none;
	}

	.book-card-list a:hover {
		color: var(--c-accent);
	}
</style>
