---
/*
 * 全部文档册：/docs/
 *
 * 一册文档 = src/content/docs/<文档册>/ 下的正文 + _book.md + _nav.yaml。
 * 卡片只展示 books 元数据里的标题、封面和简介，不再罗列册内每篇文档的摘要；
 * 整卡直达第一篇文档，完整目录在 /docs/<文档册>/，从文档页左栏的「总览」进入。
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { resolveBookCover } from '../../lib/covers';
import { docBookHref, getDocBooks } from '../../lib/posts';

const books = await getDocBooks();
const total = books.reduce((n, book) => n + book.docs.length, 0);

// 只有一册文档时，总入口直接沿用这一册的标题 / 简介；
// 多册时用中性的「文档」作为页面标题。
const pageTitle = books.length === 1 ? books[0].meta.data.title : '文档';
const pageDescription = books.length === 1 ? books[0].meta.data.description : SITE_DESCRIPTION;
---

<BaseLayout title={`${pageTitle} | ${SITE_TITLE}`} description={pageDescription} backdrop="docIndex">
	<main>
		<PageHeader title={pageTitle} meta={`${books.length} 本文档册 · 共 ${total} 篇文档`} />

		{
			books.length > 0 ? (
				<ul class="book-grid">
					{books.map((book) => {
						const { title, description, heroImage } = book.meta.data;
						const cover = resolveBookCover(book.name, heroImage);
						return (
							<li>
								{/* 整卡直达第一篇文档，省掉中间的文档清单页 */}
								<a
									class="book-card"
									href={docBookHref(book)}
									aria-label={`${title} 文档册，共 ${book.docs.length} 篇，从第一篇开始阅读`}
								>
									{cover && (
										<div class="book-card-media">
											<Image width={720} height={360} src={cover} alt="" />
										</div>
									)}
									<div class="book-card-body">
										<div class="book-card-head">
											<h2 class="book-card-title">{title}</h2>
											<span class="book-card-count">{book.docs.length} 篇</span>
										</div>
										{description && (
											<p class="book-card-desc">
												{description}
											</p>
										)}
									</div>
								</a>
							</li>
						);
					})}
				</ul>
			) : (
				<p>
					还没有文档册。在 <code>src/content/docs/&lt;文档册&gt;/</code> 添加文档，并补上
					<code>_book.md</code>（册元数据）与 <code>_nav.yaml</code>（左栏目录）即可。
				</p>
			)
		}
	</main>
</BaseLayout>

<style>
	.book-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.book-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--c-line);
		border-radius: var(--r-md);
		/* 卡片必须有实底，否则整页背景动效会从卡面透出来 */
		background: var(--c-bg);
		color: inherit;
		text-decoration: none;
		transition: border-color var(--dur-fast) var(--ease);
	}

	.book-card:hover {
		border-color: var(--c-line-strong);
	}

	.book-card-media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--c-soft);
	}

	.book-card-media :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.book-card-body {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		padding: 1.1rem 1.2rem 1rem;
	}

	.book-card-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.book-card-title {
		margin: 0;
		color: var(--c-ink);
		font-size: var(--t-h3);
		transition: color var(--dur-fast) var(--ease);
	}

	.book-card:hover .book-card-title {
		color: var(--c-accent);
	}

	.book-card-desc {
		margin: 0.45rem 0 0;
		color: var(--c-muted);
		font-size: var(--t-small);
		line-height: var(--lh-dense);
		overflow-wrap: anywhere;
	}

	.book-card-count {
		color: var(--c-quiet);
		font-size: var(--t-meta);
		white-space: nowrap;
	}
</style>
